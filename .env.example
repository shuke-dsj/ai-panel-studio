# Server only. Never use a VITE_ prefix for credentials.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
# Set an actual model ID available to your account. Do not assume a marketing name is an API ID.
MODEL_NAME=
MODEL_TIMEOUT_MS=60000
MODEL_MAX_OUTPUT_TOKENS=4000
MODEL_CONTEXT_CHARS=28000
MODEL_CONCURRENCY=3
PORT=3001
DATABASE_PATH=./data/panel.sqlite
# Explicit testing/demo mode only. Production never falls back to it.
MODEL_MODE=real
DEMO_DELAY_MS=350
